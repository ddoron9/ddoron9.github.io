{
  "name": "manager",
  "enabled": false,
  "mode": "time_bounded_delegate",
  "allowedScopes": [
    "research",
    "video"
  ],
  "activation": {
    "requiresExplicitUserTrigger": true,
    "examplePhrases": [
      "이제부터 3시간 manager",
      "몇 시간 동안 맡아",
      "manager on 4h",
      "지금부터 manager 모드"
    ]
  },
  "handoff": {
    "startAfter": "doyiclaw_initial_response",
    "continueFrom": [
      "latest_user_direction",
      "latest_assistant_result",
      "workspace_memory",
      "repo_state"
    ]
  },
  "reporting": {
    "surface": "channel",
    "avoidThreadOnlyReplies": true,
    "format": "brief_status"
  },
  "externalSend": {
    "default": "blocked_if_sensitive",
    "allowGithubPush": true,
    "blockIfContains": [
      "token",
      "key",
      "secret",
      "cookie",
      "personal_information",
      "resume_raw",
      "private_document"
    ]
  },
  "downloads": {
    "allow": [
      "library",
      "package",
      "model_weight",
      "checkpoint"
    ],
    "deny": [
      "pdf",
      "personal_document",
      "application_form_export"
    ]
  },
  "blockedActions": [
    "destructive_delete",
    "infra_change",
    "permission_change",
    "billing_change",
    "sensitive_data_handling"
  ]
}
